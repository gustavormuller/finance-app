# Production configuration (spec 010, runbook step 4). Copy to /opt/finance/.env on
# the server, fill in every <placeholder>, then `chmod 600 /opt/finance/.env`.
# Never commit the filled-in file. "__" is ":" in a .NET configuration key.
#
# Must stay ABSENT in production (the boot refuses them outside Development):
#   Ai__FakeProvider, MarketData__FakeProviders
# Set by deploy/docker-compose.yml, not here: DataProtection__KeysPath (/keys, the
# dpkeys volume) and ForwardedHeaders__KnownNetworks__0 (the compose network).

ASPNETCORE_ENVIRONMENT=Production

# Database. POSTGRES_PASSWORD and the password in the connection string are the same
# value. GSS encryption is off because the runtime image has no Kerberos library.
ConnectionStrings__Default=Host=postgres;Database=finance;Username=finance;Password=<generated>;GSS Encryption Mode=Disable
POSTGRES_PASSWORD=<generated>

# Auth (002). Redirect URI in the Google console: https://<your-domain>/api/auth/google/callback
Google__ClientId=<google-client-id>
Google__ClientSecret=<google-client-secret>
App__Origin=https://<your-domain>

# Market data (006)
MarketData__Brapi__Token=<brapi-token>
MarketData__CoinGecko__DemoKey=<coingecko-demo-key>
MarketData__TwelveData__Key=<twelvedata-key>

# AI (009). Provider is anthropic or openai; an empty value fails the boot.
Ai__Provider=anthropic
Ai__Anthropic__ApiKey=<anthropic-api-key>
# Ai__OpenAi__ApiKey=<openai-api-key>   only when Ai__Provider=openai
Ai__MonthlyBudgetBrl=15

# Cloudflare Tunnel (runbook step 5)
TUNNEL_TOKEN=<tunnel-token>

# Backup (runbook step 9): the public half of /opt/finance/backup.key (age1...).
AGE_PUBLIC_KEY=<age-public-key>
