{
	# cloudflared, on the compose network, forwards Cloudflare's X-Forwarded-Proto
	# (https) and X-Forwarded-For. Caddy passes them on only from a trusted peer;
	# otherwise it overwrites the scheme with its own plain http, and the API builds an
	# http:// Google redirect_uri. Nothing outside the Docker network reaches Caddy.
	servers {
		trusted_proxies static private_ranges
	}
}

# TLS ends at the Cloudflare edge; Caddy serves plain HTTP on the private network.
# No timeouts are set: Caddy's proxy has none by default, so a slow "Sugerir com IA"
# (several 30 s batches) is bounded by Cloudflare's 100 s, not here.
:80 {
	encode gzip
	handle /api/* {
		reverse_proxy api:8080
	}
	handle /health {
		reverse_proxy api:8080
	}
	# 022: the build output is content-hashed, so a name never changes content and any
	# cache may keep it for good. Only a 200 says so. A missing file is a 404, never the
	# SPA's index.html: a stale chunk must fail as a chunk, and an edge must not store
	# HTML under a script's name.
	handle /assets/* {
		root * /srv
		header {
			Cache-Control "public, max-age=31536000, immutable"
			match status 200
		}
		file_server
	}
	# index.html (every app route), sw.js and manifest.webmanifest must be revalidated on
	# every load, or a deploy waits for a cache to expire; the service worker is only
	# replaced when the browser sees a new sw.js. try_files serves both as the files they
	# are, with their own Content-Type.
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
