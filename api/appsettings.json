{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "MarketData": {
    "Schedule": "0 3 * * *",
    "ScheduledSync": true,
    "BackfillYears": 5,
    "Bcb": {
      "BaseUrl": "https://api.bcb.gov.br/dados/serie/bcdata.sgs.",
      "Series": {
        "CDI": { "Code": 12, "Unit": "PercentPerDay" },
        "SELIC": { "Code": 11, "Unit": "PercentPerDay" },
        "IPCA": { "Code": 433, "Unit": "PercentPerMonth" },
        "USDBRL": { "Code": 1, "Unit": "Level" }
      }
    },
    "PriceBenchmarks": {
      "IVVB11": { "Provider": "Brapi", "Symbol": "IVVB11", "Unit": "Level" }
    },
    "Brapi": {
      "BaseUrl": "https://brapi.dev/api/",
      "Token": ""
    },
    "CoinGecko": {
      "BaseUrl": "https://api.coingecko.com/api/v3/",
      "DemoKey": "",
      "VsCurrency": "usd",
      "MaxHistoryDays": 365
    },
    "TwelveData": {
      "BaseUrl": "https://api.twelvedata.com/",
      "Key": ""
    },
    "Binance": {
      "BaseUrl": "https://api.binance.com/api/v3/"
    },
    "Resilience": {
      "RetryAttempts": 3,
      "RetryBaseDelay": "00:00:02",
      "FailuresToBreak": 5,
      "SamplingDuration": "00:05:00",
      "BreakDuration": "00:05:00",
      "AttemptTimeout": "00:00:30",
      "TotalTimeout": "00:03:00"
    }
  },
  "Ai": {
    "Provider": "anthropic",
    "MonthlyBudgetBrl": 15.00,
    "Categorisation": { "Model": "claude-haiku-4-5", "TimeoutSeconds": 30 },
    "Analysis": { "Model": "claude-opus-5", "TimeoutSeconds": 120 },
    "Pricing": {
      "claude-haiku-4-5": { "InputPerMTokUsd": 1.00, "OutputPerMTokUsd": 5.00 },
      "claude-opus-5": { "InputPerMTokUsd": 5.00, "OutputPerMTokUsd": 25.00 }
    },
    "Anthropic": { "ApiKey": "", "BaseUrl": "https://api.anthropic.com/" },
    "OpenAi": { "ApiKey": "", "BaseUrl": "https://api.openai.com/" },
    "UsdBrl": 5.40,
    "FakeProvider": false,
    "AnalysisSweep": true
  },
  "Returns": {
    "Benchmarks": {
      "CDI": { "Type": "DailyRate", "Label": "CDI" },
      "SELIC": { "Type": "DailyRate", "Label": "SELIC" },
      "IPCA6": { "Type": "MonthlyRate", "Label": "IPCA + 6%", "Source": "IPCA", "Spread": 6 },
      "USDBRL": { "Type": "Level", "Label": "Dólar" },
      "IVVB11": { "Type": "Level", "Label": "S&P 500 (IVVB11)" }
    }
  }
}
