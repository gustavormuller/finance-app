{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "MarketData": {
    "Schedule": "0 3 * * *",
    "BackfillYears": 5,
    "Bcb": {
      "BaseUrl": "https://api.bcb.gov.br/dados/serie/bcdata.sgs.",
      "Series": {
        "CDI": { "Code": 12, "Unit": "PercentPerDay" },
        "SELIC": { "Code": 11, "Unit": "PercentPerDay" },
        "IPCA": { "Code": 433, "Unit": "PercentPerMonth" },
        "USDBRL": { "Code": 1, "Unit": "Level" }
      }
    },
    "Brapi": {
      "BaseUrl": "https://brapi.dev/api/",
      "Token": ""
    },
    "CoinGecko": {
      "BaseUrl": "https://api.coingecko.com/api/v3/",
      "DemoKey": "",
      "VsCurrency": "usd",
      "MaxHistoryDays": 365
    },
    "TwelveData": {
      "BaseUrl": "https://api.twelvedata.com/",
      "Key": ""
    }
  }
