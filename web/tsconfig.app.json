{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Relative to this file, so no baseUrl: TypeScript 7 drops it.
    "paths": { "@/*": ["./src/*"] },
    "jsx": "react-jsx",
    "types": ["vitest/globals"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "allowImportingTsExtensions": false,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  },
  "include": ["src"],
  // Checked by their own configs instead: sw.ts by tsconfig.sw.json against the WebWorker
  // lib, and tests that read files from disk by tsconfig.node.json with Node types.
  "exclude": ["src/sw/sw.ts", "src/**/*.node.test.ts"]
}
